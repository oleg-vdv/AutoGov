# Agent image (ТЗ §8.3: containerized deployment). Runs read-only; the Docker
# socket is mounted read-only in compose (ТЗ §9 least privilege).
FROM golang:1.24 AS build
WORKDIR /src
COPY go.mod ./
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags "-s -w" \
    -o /out/agent ./cmd/agent

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/agent /usr/local/bin/agent
# The agent is outbound-only: no EXPOSE, it never listens (ТЗ §4.2).
ENTRYPOINT ["/usr/local/bin/agent", "-config", "/etc/autogov/agent.json"]
